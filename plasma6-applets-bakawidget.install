post_install() {
	cat <<'EOF'
==> bakawidget installed.

Just add "BakaWidget" to a panel and log in via its Configure dialog —
the widget enables and starts its own background update service
automatically the first time it loads (this package can't do that step
itself: install hooks run as root with no access to your user session).

If it ever doesn't start on its own, run this as your normal user
(NOT root) instead:
    systemctl --user daemon-reload
    systemctl --user enable --now bakawidget-backend.service
EOF
}

post_upgrade() {
	post_install
}

pre_remove() {
	cat <<'EOF'
==> Before this finishes removing bakawidget, you may want
    to stop the backend and clear your stored Bakaláři credentials, as
    your normal user (NOT root):
        systemctl --user disable --now bakawidget-backend.service
        python3 /usr/share/plasma/plasmoids/bakawidget/contents/backend/bakawidget_backend.py logout
EOF
}
