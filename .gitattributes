# Force LF regardless of the committing machine's line-ending settings —
# this project ships shell scripts and a Python shebang script meant to
# run on Linux; a CRLF line ending anywhere in them breaks the interpreter
# line ("bad interpreter: ...: no such file or directory"). Written from a
# Windows dev machine with core.autocrlf=true, so this is not hypothetical.
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.qml text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.service text eol=lf
*.install text eol=lf
PKGBUILD text eol=lf
PKGBUILD.local text eol=lf
